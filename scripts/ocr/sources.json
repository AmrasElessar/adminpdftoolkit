{
  "_comment": "Bundled tools of the Windows package. With \"url\" empty the newest GitHub release is used at build time and checked against the SHA-256 GitHub publishes for the asset; set \"url\" + \"sha256\" to pin an exact file instead. The hash of every bundled file ends up in the package manifest.",
  "tesseract": {
    "github": "UB-Mannheim/tesseract",
    "asset": "^tesseract-ocr-w64-setup-[0-9.]+\\.exe$",
    "url": "",
    "sha256": ""
  },
  "ghostscript": {
    "github": "ArtifexSoftware/ghostpdl-downloads",
    "asset": "^gs[0-9]+w64\\.exe$",
    "source_asset": "^ghostscript-[0-9.]+\\.tar\\.gz$",
    "url": "",
    "sha256": ""
  },
  "tessdata": {
    "tur": {"url": "https://github.com/tesseract-ocr/tessdata_fast/raw/4.1.0/tur.traineddata", "sha256": ""},
    "eng": {"url": "https://github.com/tesseract-ocr/tessdata_fast/raw/4.1.0/eng.traineddata", "sha256": ""},
    "osd": {"url": "https://github.com/tesseract-ocr/tessdata_fast/raw/4.1.0/osd.traineddata", "sha256": ""}
  }
}
